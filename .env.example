PORT=5001
NODE_ENV=development
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:5173
# --- AI trip planner (Google Gemini; key stays on the server only) ---
GEMINI_API_KEY=
# Pick a currently supported FREE-tier model from https://ai.google.dev/gemini-api/docs/models (no default on purpose)
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=16000
# Optional Google Search grounding for recent-info notes. Off by default: may be unavailable/paid for some models or tiers.
GEMINI_GROUNDING=false
# --- Free travel data providers (optional overrides; OSRM_URL= (empty) disables road routing) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1
# OSM policies require an identifying User-Agent with contact details
TRAVEL_DATA_USER_AGENT=BharatDarshan/1.0 (contact: you@example.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
# frontend/.env.example
VITE_API_BASE_URL=http://localhost:5001/api/v1
